# .env.example
# CertForge AI Production Configuration Template

# Application
PROJECT_NAME="CertForge AI"
API_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & CORS
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="https://certforge.yourcompany.com,https://api.certforge.yourcompany.com"

# WARNING: Replace this with a secure 256-bit key in production
# Run: openssl rand -hex 32
SECRET_KEY="replace_me_with_a_highly_secure_random_string_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Database (MongoDB Atlas)
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="certforge_prod"

# AI Models & Agents
# Required for Foundry IQ Embeddings and LangGraph orchestration
GEMINI_API_KEY="your_google_gemini_api_key"

# Monitoring (Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=...;IngestionEndpoint=..."
